# Copier en `.env` (domaines et tags, lu par docker compose), `.env.recette` et `.env.prod` (variables de l'application).
# Aucun secret dans ce fichier : renseigner les vraies valeurs sur le VPS uniquement.

# --- deploy/.env ---
RECETTE_DOMAIN=recette.example.com
PROD_DOMAIN=app.example.com
# Tags d'image : fixer un tag précis en prod, c'est ce qui permet le retour arrière.
RECETTE_TAG=latest
PROD_TAG=latest

# --- deploy/.env.recette et deploy/.env.prod (un fichier par environnement, valeurs distinctes) ---
# Neon, région aws-eu-central-1 : URL poolée et URL directe du projet de l'environnement.
DATABASE_URL=
DATABASE_URL_DIRECT=
# Chaîne aléatoire (openssl rand -hex 32), différente par environnement. Ne jamais l'omettre.
SESSION_SECRET=
# URL publique de l'environnement (origine CORS ; celle de prod est aussi celle de l'APK et de la PWA).
APP_URL=https://recette.example.com
# Sauvegarde applicative coupée : pg_dump absent de l'image, la base repose sur le PITR Neon.
BACKUP_ENABLED=0
# Optionnelles : CORS_ORIGIN, LOG_LEVEL, FEATURE_FLAGS, KPI_PREVENTIVE_TOLERANCE_DAYS
