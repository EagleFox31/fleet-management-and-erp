# Copier en `.env` (lu par docker compose), `.env.recette` et `.env.prod` (variables de l'application).
# Aucun secret dans ce fichier : renseigner les vraies valeurs sur le VPS uniquement.
# Le serveur de site (PC sur le LAN) n'a besoin d'aucun de ces fichiers : docs/deploiement/site-local.md.

# --- deploy/.env ---
RECETTE_DOMAIN=recette.example.com
PROD_DOMAIN=app.example.com
# Tags d'image : fixer un tag précis en prod, c'est ce qui permet le retour arrière.
RECETTE_TAG=latest
PROD_TAG=latest
# Mots de passe des bases en conteneur (openssl rand -hex 24), distincts. Vides : Postgres refuse de démarrer.
RECETTE_DB_PASSWORD=
PROD_DB_PASSWORD=

# --- deploy/.env.recette et deploy/.env.prod (un fichier par environnement, valeurs distinctes) ---
# Base en conteneur : hôte db-recette (ou db-prod), même mot de passe que dans deploy/.env.
DATABASE_URL=postgres://fleet:<mot de passe>@db-recette:5432/fleet
# Le driver Neon joint Postgres par le proxy WebSocket du compose.
DATABASE_WS_PROXY=wsproxy:80/v1
# Chaîne aléatoire (openssl rand -hex 32), différente par environnement. Absente : le serveur refuse de démarrer.
SESSION_SECRET=
# URL publique de l'environnement (origine CORS ; celle de prod est aussi celle de l'APK et de la PWA).
APP_URL=https://recette.example.com
# Sauvegarde applicative coupée : sauvegarde par pg_dump depuis l'hôte (docs/deploiement/vps.md, §6).
BACKUP_ENABLED=0
# Optionnelles : CORS_ORIGIN, LOG_LEVEL, FEATURE_FLAGS, KPI_PREVENTIVE_TOLERANCE_DAYS
