# Copier vers `.env` (jamais commité).

# Base Neon du projet — `npm run dev`, Playwright, et tests integration/contrat.
DATABASE_URL=

# Optionnel. Par défaut = DATABASE_URL (même Neon, données TEST-* nettoyées après coup).
# Ne pas renseigner ici : les suites intégration/contrat ne lisent pas .env.
# Exporter dans le shell : DATABASE_URL_TEST=postgres://fleet:fleet@postgres:5432/fleet_test (tests/README.md)
# DATABASE_URL_TEST=
# Optionnel. Proxy WebSocket vers un Postgres hors Neon (tests locaux : docker-compose.test.yml), ex. localhost:5433/v1.
DATABASE_WS_PROXY=
# Optionnel. Plafond d'ouverture d'une connexion Postgres, en ms (défaut 10000, 0 = sans plafond).
# Borne aussi l'attente d'une place libre dans le pool (server/lib/db-pool-options.ts).
DATABASE_CONNECT_TIMEOUT_MS=

# Secret de session Express (dev local).
# En production (NODE_ENV=production), le serveur refuse de démarrer si SESSION_SECRET est
# absent, fait moins de 32 caractères ou vaut cette valeur d'exemple (server/lib/session-secret.ts).
SESSION_SECRET=change-me-in-dev

# Sauvegarde quotidienne chiffrée (T-19). Active par défaut en production seulement ;
# BACKUP_ENABLED=1 la force ailleurs, 0 la coupe. BACKUP_KEY : 32 octets (voir server/lib/backup/encrypt.ts).
BACKUP_ENABLED=
BACKUP_KEY=

# Plafond d'échecs de connexion par adresse IP (server/middleware/auth-ip-limit.ts), devant
# /api/auth/login et /api/auth/pin-login. IPv6 comptée par /64. Valeur absente ou invalide
# (non entière, nulle, négative) : 20 échecs par fenêtre de 15 minutes. À relever si plusieurs
# chauffeurs se connectent derrière le même NAT d'un dépôt. Les refus 429 d'un compte verrouillé et
# les 503 (compteur indisponible) consomment aussi ce budget : derrière un NAT, un compte verrouillé
# ou une panne du compteur peut épuiser l'IP de tout le dépôt, d'où le relèvement par AUTH_IP_FAILURE_MAX.
AUTH_IP_FAILURE_MAX=
AUTH_IP_WINDOW_MINUTES=

# Sauts de reverse proxy de confiance (server/lib/trust-proxy.ts) : ils fixent l'adresse IP lue dans
# X-Forwarded-For, donc la limite d'essais par IP. 1 derrière Caddy (défaut, vps et recette),
# 0 quand l'application est publiée sans proxy (profil site, déjà réglé dans deploy/docker-compose.yml).
# Absent ou invalide : 1.
TRUST_PROXY=

# Rétention des positions GPS (vehicle_positions), en jours : la fonction SQL purge_vehicle_positions
# supprime les points relevés avant cette durée (server/lib/gps-retention.ts). Absent ou invalide (non entier,
# nul, négatif, au-delà de 3650) : 30 jours. La purge quotidienne est planifiée par le serveur (lot API GPS).
GPS_POSITION_RETENTION_DAYS=
