# Scripts de garde lancés par node et importés par Vitest : un shebang suivi de CR casse l'import.
.claude/hooks/*.mjs text eol=lf
deploy/*.sh text eol=lf
# Snapshots Vitest : écrits en LF par Vitest. Sortis en CRLF (core.autocrlf), ils étaient réécrits à chaque
# passe et laissaient l'arbre modifié. Test : tests/unit/gitattributes-snapshots.test.ts.
**/__snapshots__/*.snap text eol=lf

# Fichiers tenus en ajout de fin seulement : deux PR qui ajoutent chacune une entrée ne se bloquent
# plus au merge local (git garde les deux côtés). GitHub n'applique pas union côté serveur : la PR
# reste CONFLICTING jusqu'au merge local de main, qui devient trivial. Test : gitattributes-union.
docs/analysis/LESSONS_LEARNED.md merge=union
docs/journal/*.md merge=union
PASSATION*.md merge=union
# Journal de couverture : un fichier par entrée, plus de conflit (tests/unit/docs/journal-fragments.test.ts).
# LF fixé : le test de non-perte recolle les fragments et compare une empreinte.
docs/qa/journal/** text eol=lf

# Le README du journal se réécrit : fusion normale, conflit visible.
docs/journal/README.md merge=text
