{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --exclude \"*.timestamp-*.mjs\" --env-file=.env server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "check:tests": "node scripts/check-tests-types.mjs",
    "db:push": "drizzle-kit push",
    "backfill:created-by": "tsx --env-file=.env scripts/backfill-created-by.ts",
    "backfill:vehicle-document-master-dates": "node --env-file=.env --import tsx scripts/backfill-vehicle-document-master-dates.ts",
    "backfill:procurement-reception-stock": "tsx --env-file=.env scripts/backfill-procurement-reception-stock.ts",
    "backfill:preventive-schedules": "tsx --env-file=.env scripts/backfill-preventive-schedules.ts",
    "backfill:procurement-auto-invoices": "tsx --env-file=.env scripts/backfill-procurement-auto-invoices.ts",
    "benchmark:management-dashboard": "tsx --env-file=.env scripts/benchmark-management-dashboard.ts",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "journal:index": "tsx scripts/doc-fragments.ts index",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "test:integration": "node ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:contract": "node ./node_modules/vitest/vitest.mjs run --config vitest.contract.config.ts",
    "test:all": "npm test && npm run test:integration && npm run test:contract",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait && npm run test:db:schema",
    "test:db:schema": "cross-env DATABASE_URL=postgres://fleet:fleet@localhost:54320/fleet_test drizzle-kit push --force",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "cap:build": "npm run build && npx cap sync"
  },
